{
  "name": "kakeibo-rag",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && python scripts/prefetch_model.py",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "remoteEnv": {
    "HF_HOME": "${containerWorkspaceFolder}/models/hf_cache"
  }
}
